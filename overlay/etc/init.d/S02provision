#!/bin/sh
# Restore provisioning data (hostname, timezone, root password, SSH key)
# from the U-Boot environment on the first boot after an overlay wipe.
# Runs before S04hostname so the restored hostname is kept as-is.
# Wi-Fi credentials are restored separately by S38wpa_supplicant.
# See /usr/sbin/provision-env.

start() {
	echo -c 15 "Checking provisioning data"
	[ -x /usr/sbin/provision-env ] && /usr/sbin/provision-env restore
}

case "$1" in
	start | restart)
		start
		;;
	stop)
		true
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
