#!/bin/sh
# S59motor - motor (PTZ) init script.
#
# Actions:
#   start       load the motor module + daemon, home and position (boot).
#   stop        stop daemon, unload the module (shutdown).
#   restart     stop + start.
#   reload      apply a changed motors.json that needs new module
#               parameters (e.g. direction reversal): reloads the motor
#               kernel module in place. The camera keeps streaming and
#               only the motors pause (~10s), so a motor config change no
#               longer needs a full system reboot.
#   reposition  apply a changed home position (motors.pos_0) only -- a
#               plain absolute move, no module reload, no reboot.
#
# reload exit codes, so a caller reboots only when it is truly required:
#   0  new parameters applied.
#   3  motor module could not be unloaded (busy); parameters NOT applied
#      -- motors keep running on the previous config, and a full reboot
#      is required to apply the change.

DAEMON="/usr/bin/motors-daemon"
DAEMON_ARGS="-d -p"
PIDFILE="/run/motors-daemon.pid"

ensure_command() {
	if ! command -v "$1" >/dev/null 2>&1; then
		echo "Missing $1" >&2
		exit 1
	fi
}

start_daemon() {
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $@
}

stop_daemon() {
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON"
		status=$?
		rm -f "$PIDFILE"
		return $status
	fi

	start-stop-daemon -K -x "$DAEMON"
}

MOTORS_CONFIG="/etc/motors.json"

ensure_command "motors"

set_motor_phases() {
	if [ "$(echo $2 | wc -w)" -lt 4 ]; then
		echo "Missing phase for ${1}motor" >&2
		exit 1
	fi

	local i=1
	for gpio in $2; do
		eval "${1}st${i}=$gpio"
		i=$((i + 1))
	done
}

home_motors() {
	echo "Home motors"
	motors -r
}

set_motors_speed() {
	echo "Set motors speed to $speed_pan"
	motors -s $1
}

position_motors() {
	local x y

	pos_0=$(jct $MOTORS_CONFIG get motors.pos_0)

	if [ -n "$pos_0" ]; then
		x=$(echo $pos_0 | cut -d, -f1)
		y=$(echo $pos_0 | cut -d, -f2)
	else
		x=$((steps_pan / 2))
		y=$((steps_tilt / 2))
	fi

	echo "Move to $x,$y"
	motors -d h -x $x -y $y
}

start() {
	echo -c 15 "Setting up motors"

	gpio_pan=$(jct $MOTORS_CONFIG get motors.gpio_pan)
	gpio_tilt=$(jct $MOTORS_CONFIG get motors.gpio_tilt)
	gpio_switch=$(jct $MOTORS_CONFIG get motors.gpio_switch)
	gpio_invert=$(jct $MOTORS_CONFIG get motors.gpio_invert)
	steps_pan=$(jct $MOTORS_CONFIG get motors.steps_pan)
	steps_tilt=$(jct $MOTORS_CONFIG get motors.steps_tilt)
	speed_pan=$(jct $MOTORS_CONFIG get motors.speed_pan)
	speed_tilt=$(jct $MOTORS_CONFIG get motors.speed_tilt)
	homing=$(jct $MOTORS_CONFIG get motors.homing)
	is_spi=$(jct $MOTORS_CONFIG get motors.is_spi)
	invert_x=$(jct $MOTORS_CONFIG get motors.invert_x)
	invert_y=$(jct $MOTORS_CONFIG get motors.invert_y)

	[ -z "$gpio_pan" ] && echo "gpio_pan is not set"
	[ -z "$gpio_tilt" ] && echo "gpio_tilt is not set"
	[ -z "$gpio_switch" ] && echo "gpio_switch is not set"

	# defaults
	[ -z "$steps_pan" ] && steps_pan=4000
	[ -z "$steps_tilt" ] && steps_tilt=2000
	[ -z "$speed_pan" ] && speed_pan=900
	[ -z "$speed_tilt" ] && speed_tilt=900

	if grep -qE "^motor" /proc/modules; then
		echo "Module motor already loaded."
	else
		modprobe_args="hmaxstep=$steps_pan vmaxstep=$steps_tilt"

		if [ "true" = "$is_spi" ]; then
			if [ -n "$invert_x" ]; then
				modprobe_args="$modprobe_args invert_x=$invert_x"
			fi

			if [ -n "$invert_y" ]; then
				modprobe_args="$modprobe_args invert_y=$invert_y"
			fi
		else
			modprobe_args="$modprobe_args tcu_channels=2"

			echo "Set GPIO per motor phase"
			set_motor_phases "h" "$gpio_pan"
			set_motor_phases "v" "$gpio_tilt"
			modprobe_args="$modprobe_args hst1=$hst1 hst2=$hst2 hst3=$hst3 hst4=$hst4"
			[ -z "$vst1" ] && vst1="$hst1"
			[ -z "$vst2" ] && vst2="$hst2"
			[ -z "$vst3" ] && vst3="$hst3"
			[ -z "$vst4" ] && vst4="$hst4"
			modprobe_args="$modprobe_args vst1=$vst1 vst2=$vst2 vst3=$vst3 vst4=$vst4"

			if echo "$gpio_switch" | grep -qE '^[0-9]+$'; then
				modprobe_args="$modprobe_args motor_switch_gpio=$gpio_switch"
			fi

			if [ "true" = "$gpio_invert" ]; then
				modprobe_args="$modprobe_args invert_gpio_dir=1"
			fi
		fi

		echo "Load motor module with parameters: $modprobe_args"

		if ! modprobe motor $modprobe_args; then
			echo "Failed to load motor module" >&2
			exit 1
		fi
	fi

	# shellcheck disable=SC2086
	start_daemon $DAEMON_ARGS
	# FIXME: daemon should be reporting running state from the very first moment
	sleep 1

	# FIXME: motors may have different speeds for pan and tilt
	set_motors_speed $speed_pan

	if [ "false" = "$homing" ]; then
		echo "Homing disabled"
	else
		home_motors
		position_motors
	fi
}

stop() {
	echo -c 15 "Stopping motors"

	stop_daemon

	if ! rmmod motor; then
		echo "Failed to unload motor module." >&2
		exit 1
	fi
}

# Stop the daemon and wait for it to release the motor device, so the
# rmmod that follows is not refused for a busy module.
graceful_daemon_stop() {
	stop_daemon
	i=0
	while pidof motors-daemon >/dev/null 2>&1; do
		[ "$i" -ge 5 ] && break
		sleep 1
		i=$((i + 1))
	done
	# Last resort: a daemon that ignored SIGTERM still pins the module.
	pidof motors-daemon >/dev/null 2>&1 && killall -9 motors-daemon 2>/dev/null
}

# Unload the motor module, retrying while it is still busy. Returns 0
# once the module is gone, 1 if it could not be unloaded.
unload_module_retry() {
	i=0
	while [ "$i" -lt 5 ]; do
		grep -qE "^motor " /proc/modules || return 0
		rmmod motor 2>/dev/null && return 0
		echo "motor module busy, retrying unload..." >&2
		sleep 1
		i=$((i + 1))
	done
	grep -qE "^motor " /proc/modules && return 1
	return 0
}

# Apply a motors.json change that needs new module parameters (e.g. a
# direction reversal) by reloading the motor module in place instead of
# rebooting the camera.
reload() {
	echo -c 15 "Reloading motor module"
	graceful_daemon_stop
	if unload_module_retry; then
		start
		return 0
	fi
	# Module still loaded with the previous parameters: the motors stay
	# usable on the old config, but the new one needs a reboot to apply.
	echo "motor module could not be unloaded; new parameters NOT applied." >&2
	echo "A full reboot is required to apply this motor configuration." >&2
	start
	return 3
}

# Apply a changed home position only (motors.pos_0): a plain absolute
# move, no module reload, no reboot.
reposition() {
	echo -c 15 "Repositioning motors to configured home"
	steps_pan=$(jct $MOTORS_CONFIG get motors.steps_pan)
	steps_tilt=$(jct $MOTORS_CONFIG get motors.steps_tilt)
	[ -z "$steps_pan" ] && steps_pan=4000
	[ -z "$steps_tilt" ] && steps_tilt=2000
	position_motors
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	reload)
		reload
		exit $?
		;;
	reposition)
		reposition
		exit $?
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|reposition}"
		exit 1
		;;
esac

exit 0
