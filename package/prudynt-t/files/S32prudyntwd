#!/bin/sh
# S32prudyntwd - prudynt encoder watchdog
#
# Detects a wedged encoder pipeline - the RTSP server is up but stream0's
# media session was never registered (DESCRIBE ch0 -> 404) because an
# IMPEncoder::init() failed on this SoC's VPU - and recovers it by:
#   1. restarting prudynt once (handles transient bring-up races), then
#   2. progressively dropping the least important encoder channels
#      (stream3 -> stream2 -> stream1) via prudynt-vpu-guard until the
#      pipeline comes up, or alerting if only stream0 is left.
#
# A plain restart cannot fix a deterministic VPU overcommit, so escalation
# to channel degradation is the actual self-heal. Live status is published
# to /run/prudynt-vpu-guard.status for fleet management to consume.

PATH=/bin:/sbin:/usr/bin:/usr/sbin${PATH:+:$PATH}
export PATH

PIDFILE="/run/prudynt-watchdog.pid"
PRUDYNT_PIDFILE="/run/prudynt.pid"
PRUDYNT_INIT="/etc/init.d/S31prudynt"
GUARD="/usr/sbin/prudynt-vpu-guard"
PORTAL_MODE_FLAG="/run/portal_mode"
TAG="prudynt-watchdog"

INTERVAL=30          # seconds between checks
GRACE=90             # seconds to allow encoder bring-up after a (re)start
FAIL_THRESHOLD=2     # consecutive bad probes before acting
ALERT_INTERVAL=1800  # slow poll once no channels remain to drop

log() {
	logger -t "$TAG" "$1" 2>/dev/null
	echo "$TAG: $1"
}

is_disabled() {
	[ "true" = "$disable_streamer" ] || [ -f "$PORTAL_MODE_FLAG" ]
}

file_mtime() {
	stat -c %Y "$1" 2>/dev/null || date -r "$1" +%s 2>/dev/null || echo 0
}

prudynt_running() {
	[ -f "$PRUDYNT_PIDFILE" ] || return 1
	pid=$(cat "$PRUDYNT_PIDFILE" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

prudynt_age() {
	# seconds since the prudynt pidfile was (re)created, i.e. since start
	echo $(( $(date +%s) - $(file_mtime "$PRUDYNT_PIDFILE") ))
}

remediate_restart() {
	# remediate_restart <message> <status-state>
	log "$1"
	"$GUARD" report "$2" "$1" 2>/dev/null
	"$PRUDYNT_INIT" restart >/dev/null 2>&1
}

watch() {
	fail=0       # consecutive failed probes
	attempt=0    # remediation attempts in the current wedge episode
	interval=$INTERVAL

	while true; do
		sleep "$interval"
		interval=$INTERVAL

		is_disabled && continue
		[ -x "$GUARD" ] || continue

		# prudynt fully dead - S31prudynt has no respawn, so revive it.
		if ! prudynt_running; then
			fail=0
			attempt=$((attempt + 1))
			remediate_restart "prudynt is not running - starting it" "down"
			continue
		fi

		# Give the encoder time to come up after any (re)start.
		[ "$(prudynt_age)" -lt "$GRACE" ] && continue

		if "$GUARD" probe; then
			if [ "$attempt" -gt 0 ] || [ "$fail" -gt 0 ]; then
				log "stream0 healthy again ($("$GUARD" active) channel(s) active)"
			fi
			fail=0
			attempt=0
			"$GUARD" report healthy "stream0 RTSP session registered" 2>/dev/null
			continue
		fi

		# Probe failed - confirm it is not a one-off blip.
		fail=$((fail + 1))
		[ "$fail" -lt "$FAIL_THRESHOLD" ] && continue
		fail=0
		attempt=$((attempt + 1))

		# First attempt: a plain restart clears transient bring-up races.
		if [ "$attempt" -le 1 ]; then
			remediate_restart "stream0 wedged - restarting prudynt" "wedged"
			continue
		fi

		# Persistent wedge: drop a channel and restart.
		dropped=$("$GUARD" degrade)
		if [ -n "$dropped" ]; then
			remediate_restart "stream0 still wedged - dropped $dropped, restarting" "wedged"
		else
			log "stream0 wedged and no channels left to drop - manual attention needed"
			"$GUARD" report alert "encoder wedged with only stream0 configured" 2>/dev/null
			"$PRUDYNT_INIT" restart >/dev/null 2>&1
			interval=$ALERT_INTERVAL
		fi
	done
}

start() {
	echo -c 15 "Starting Prudynt Watchdog"
	if is_disabled; then
		echo "Streamer disabled, watchdog not started"
		exit 0
	fi
	watch &
	echo $! > "$PIDFILE"
}

stop() {
	echo -c 15 "Stopping Prudynt Watchdog"
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
		rm -f "$PIDFILE"
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
